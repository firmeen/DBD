DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=dbd
DB_USER=dbd-data
DB_PASSWORD=change_me
REQUEST_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36

DBD_BASE_URL=https://datawarehouse.dbd.go.th
DBD_MAX_AUTH_ATTEMPTS=4

# Sequential path (fetch-company): fixed pause between requests.
DBD_REQUEST_DELAY_SECONDS=0.5

# Concurrent path (discover): a single token bucket caps the whole process.
# This is a public government service - keep these moderate.
DBD_CONCURRENCY=15
DBD_RATE_PER_SECOND=15
# Counting a large bucket is slow server-side (a ~963k-row keyword exceeded 40s).
DBD_COUNT_TIMEOUT_SECONDS=120
DBD_WRITE_BATCH_SIZE=500

# One async API manager; concurrent requests share one rate limit.
DB_POOL_SIZE=8
DB_TIMEOUT=30
DBD_QUEUE_SIZE=64
DBD_LEASE_SECONDS=300
DBD_MAX_TASK_ATTEMPTS=3
DBD_HTTP_RETRIES=3
# Metrics are disabled at 0; otherwise exposed only on 127.0.0.1.
DBD_METRICS_PORT=0

# ------------------------------------------------------------------
# Redis coordination
# Required for campaign / distributed workers / distributed discovery
# ------------------------------------------------------------------

DBD_REDIS_URL="rediss://<USERNAME>:<PASSWORD>@<REDIS_ENDPOINT>:<PORT>"
DBD_REDIS_RATE_KEY=dbd:dev:global-rate
# One bounded async Redis pool is shared by coordination + admission per worker.
DBD_REDIS_MAX_CONNECTIONS=4
DBD_REDIS_POOL_WAIT_SECONDS=5
DBD_REDIS_SOCKET_TIMEOUT_SECONDS=5
DBD_REDIS_CONNECT_TIMEOUT_SECONDS=5
DBD_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=15
DBD_REDIS_RECOVERY_INTERVAL_SECONDS=5
# Optional fleet-wide cap reserved across supervisor + workers.
DBD_FLEET_REDIS_CONNECTIONS_MAX=128