DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dbd
DB_USER=dbd-data
DB_PASSWORD=change_me
REQUEST_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36

DBD_BASE_URL=https://datawarehouse.dbd.go.th
DBD_MAX_AUTH_ATTEMPTS=4

# Sequential path (fetch-company): fixed pause between requests.
DBD_REQUEST_DELAY_SECONDS=0.5

# Concurrent path (discover): a single token bucket caps the whole process.
# This is a public government service - keep these moderate.
DBD_CONCURRENCY=15
DBD_RATE_PER_SECOND=15
# Counting a large bucket is slow server-side (a ~963k-row keyword exceeded 40s).
DBD_COUNT_TIMEOUT_SECONDS=120
DBD_WRITE_BATCH_SIZE=500
